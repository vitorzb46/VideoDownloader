<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<AssemblyName>vdm</AssemblyName>
	<RootNamespace>VideoDownloader</RootNamespace>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<AnalysisMode>All</AnalysisMode>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="LibVLCSharp" Version="3.10.1" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.7" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    <PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.1-a.1" />
    <PackageReference Include="YoutubeExplode.Converter" Version="6.6.1-a.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Projeto WPF separado: exclui a subpasta Player dos globs padrão do SDK
         (Compile/Page/None/EmbeddedResource), evitando que o console compile os fontes WPF. -->
    <Compile Remove="Player\**" />
    <Page Remove="Player\**" />
    <ApplicationDefinition Remove="Player\**" />
    <None Remove="Player\**" />
    <EmbeddedResource Remove="Player\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\DownloadApplication.resx">
      <LogicalName>$(AssemblyName).Resources.$(RootNamespace).DownloadApplication.resources</LogicalName>
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TorrentDownloadService.resx">
      <LogicalName>$(AssemblyName).Resources.$(RootNamespace).Services.Implementation.TorrentDownloadService.resources</LogicalName>
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
