<Window x:Class="VideoDownloader.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Torrent Player" Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid>
        <!-- Somente o vídeo: os controles vivem na ControlsWindow (janela separada),
             evitando o airspace do HWND nativo bloquear os cliques. -->
        <vlc:VideoView x:Name="VideoView" />
    </Grid>
</Window>


