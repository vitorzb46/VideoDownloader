<Window x:Class="VideoDownloader.Player.ControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls" Width="1280" Height="110"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        MouseMove="Window_MouseMove">

    <Border Background="#CC000000" BorderBrush="#333333" BorderThickness="1">
        <Grid Margin="12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Linha do tempo -->
            <Slider x:Name="TimelineSlider" Grid.Row="0"
                    Minimum="0" Maximum="100"
                    Value="{Binding Position, Mode=TwoWay}"
                    PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                    PreviewMouseUp="TimelineSlider_PreviewMouseUp" />

            <!-- Botões + volume -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="PlayPauseButton" Content="Play/Pause" Click="PlayPauseButton_Click" Width="90" />
                <Button Content="Tela Cheia" Click="FullscreenButton_Click" Width="80" Margin="8,0,0,0" />
                <TextBlock Text="Volume:" Foreground="White" VerticalAlignment="Center" Margin="16,0,4,0" />
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>

            <!-- Seleção de áudio e legendas -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Áudio:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="AudioCombo" Grid.Column="1" Width="160"
                          ItemsSource="{Binding AudioTracks}"
                          DisplayMemberPath="Name"
                          SelectionChanged="AudioCombo_SelectionChanged" />
                <TextBlock Text="Legenda:" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="SubtitleCombo" Grid.Column="3" Width="160"
                          ItemsSource="{Binding SubtitleTracks}"
                          DisplayMemberPath="Name"
                          SelectionChanged="SubtitleCombo_SelectionChanged" />
                <Button Grid.Column="4" Content="Carregar Legenda (.srt)" HorizontalAlignment="Right"
                        Click="LoadSubtitleButton_Click" Margin="16,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
