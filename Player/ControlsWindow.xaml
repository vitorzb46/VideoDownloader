<Window x:Class="VideoDownloader.Player.ControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls" Width="1280" Height="110"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        MouseMove="Window_MouseMove">

    <Border Background="#CC000000" BorderBrush="#333333" BorderThickness="1" HorizontalAlignment="Stretch">
        <Grid Margin="24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Linha do tempo -->
            <Slider x:Name="TimelineSlider" Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding Position, Mode=TwoWay}" PreviewMouseDown="TimelineSlider_PreviewMouseDown" PreviewMouseUp="TimelineSlider_PreviewMouseUp" />

            <!-- Botões + volume -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="PlayPauseButton" Content="▶ / ⏸" Click="PlayPauseButton_Click" Width="100" Height="32" Background="#222222" Foreground="White" BorderBrush="#444444" FontWeight="Bold" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                <Button Content="🔲 Tela Cheia" Click="FullscreenButton_Click" Width="110" Height="32" Margin="15,0,0,0" Background="#222222" Foreground="White" BorderBrush="#444444" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                <TextBlock Text="🔊 Volume:" Foreground="White" VerticalAlignment="Center" Margin="20,0,6,0" />
                <Slider x:Name="VolumeSlider" Width="140" Minimum="0" Maximum="100" VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>

            <!-- Seleção de áudio e legendas -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Áudio:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="AudioCombo" Grid.Column="1" Width="160" ItemsSource="{Binding AudioTracks}" DisplayMemberPath="Name" SelectionChanged="AudioCombo_SelectionChanged" />
                <TextBlock Text="Legenda:" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="SubtitleCombo" Grid.Column="3" Width="160" ItemsSource="{Binding SubtitleTracks}" DisplayMemberPath="Name" SelectionChanged="SubtitleCombo_SelectionChanged" />
                <Button Grid.Column="4" Content="Carregar Legenda (.srt)" HorizontalAlignment="Right" Click="LoadSubtitleButton_Click" Margin="10,0,10,0" Background="#222222" Foreground="White" BorderBrush="#444444" FontWeight="Bold" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
