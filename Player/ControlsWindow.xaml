<Window x:Class="VideoDownloader.Player.ControlsWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:player="clr-namespace:VideoDownloader.Player" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Controls" Width="1280" Height="100"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        MouseMove="Window_MouseMove" SnapsToDevicePixels="True">

    <!-- Estilo local para deixar todos os botões do player minimalistas e sem bordas quadradas chatas -->
    <Window.Resources>
        <!-- 1. ESTILO PERSONALIZADO PARA A BARRA DE ROLAGEM ESCURA -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- Canaleta por onde o indicador desliza -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <!-- O indicador que você arrasta com o mouse -->
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Cor do indicador: #4E5566 (Cinza Escuro) -->
                                                <Border Background="#4E5566" CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. TEMPLATE DO ITEM DE MENU (CORRIGIDO E COM SCROLL ATIVADO) -->
        <ControlTemplate x:Key="LimpaBordaMenuItemTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,0,0,1" 
                    Padding="{TemplateBinding Padding}">
                    <Grid>
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Arrow" Text="▶" Foreground="White" FontSize="10" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Popup x:Name="SubMenuPopup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <!-- O ScrollViewer herda automaticamente o estilo de ScrollBar definido acima -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D323F"/>
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2D323F"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <!-- Cria uma linha pura que ignora as margens de ícone do Windows -->
                        <Rectangle Height="1" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo Escuro para o Menu Suspenso (ContextMenu) que desativa a coluna de ícones -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D323F"/>
            <Setter Property="Background" Value="#F51A1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Remove o layout padrão do Windows e cria uma caixa limpa livre de faixas brancas -->
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
                            <ScrollViewer Margin="0">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo para os itens de dentro do Menu (Áudio e Legenda) -->
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12, 6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D323F"/>
            <Setter Property="Background" Value="#F51A1E24"/>
            <Setter Property="Template" Value="{StaticResource LimpaBordaMenuItemTemplate}"/>
        </Style>        
        <!-- Estilo minimalista para os botões do player -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        
    </Window.Resources>

    <!-- Barra Principal Flutuante -->
    <Border Background="#E61A1E24" BorderBrush="#2D323F" BorderThickness="1" 
            HorizontalAlignment="Center" VerticalAlignment="Center" 
            CornerRadius="8" Height="75" Width="1100">

        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Linha do Tempo (Slider Superior) -->
            <Slider x:Name="TimelineSlider" Grid.Row="0" Minimum="0" Maximum="100" 
                    Value="{Binding Position, Mode=TwoWay}" 
                    Margin="0,-4,0,0" Height="12" VerticalAlignment="Top" Background="Transparent"
                    PreviewMouseDown="TimelineSlider_PreviewMouseDown" PreviewMouseUp="TimelineSlider_PreviewMouseUp" />

            <!-- Barra de Ferramentas Distribuída -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- BLOCO ESQUERDO: Reprodução e Controle de Tempo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏪" Style="{StaticResource PlayerButtonStyle}" FontSize="13" ToolTip="Voltar 10s"/>
                    <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPauseButton_Click" Style="{StaticResource PlayerButtonStyle}" FontSize="18" ToolTip="Reproduzir / Pausar"/>
                    <Button Content="⏩" Style="{StaticResource PlayerButtonStyle}" FontSize="13" ToolTip="Avançar 10s"/>
                    <Button Content="🔊" Style="{StaticResource PlayerButtonStyle}" Width="35" ToolTip="Mutar"/>
                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" 
                            VerticalAlignment="Center" Margin="5,0,0,0"
                            Value="{Binding Volume, Mode=TwoWay}" />
                </StackPanel>

                <!-- BLOCO DIREITO: Configurações e Funções de Arquivo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁" Click="LoadSubtitleButton_Click" Style="{StaticResource PlayerButtonStyle}" FontSize="16" ToolTip="Carregar Legenda ou Arquivo (.srt / .torrent)"/>

                    <!-- Botão de Configurações com Menu Suspenso acoplado -->
                    <Button Content="⚙" Style="{StaticResource PlayerButtonStyle}" ToolTip="Áudio, Legendas e Ajustes" Click="SettingsButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                <!-- Aplicamos os estilos diretamente nos submenus e forçamos a MaxHeight neles para conter as 30+ legendas -->
                                <MenuItem
                                      Header="🗣 Idioma do Áudio" 
                                      Style="{StaticResource DarkMenuItemStyle}"
                                      ItemContainerStyle="{StaticResource DarkMenuItemStyle}"
                                      ItemsSource="{Binding AudioTracks}" 
                                      DisplayMemberPath="Name"
                                      ButtonBase.Click="AudioMenuItem_Click">
                                    <MenuItem.Resources>
                                        <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenuStyle}">                                            
                                            <Setter Property="MaxHeight" Value="150"/>
                                        </Style>
                                    </MenuItem.Resources>
                                </MenuItem>

                                <MenuItem
                                      Header="💬 Legendas" 
                                      Style="{StaticResource DarkMenuItemStyle}"
                                      ItemContainerStyle="{StaticResource DarkMenuItemStyle}"
                                      ItemsSource="{Binding SubtitleTracks}" 
                                      DisplayMemberPath="Name"
                                      ButtonBase.Click="SubtitleMenuItem_Click">
                                    <MenuItem.Resources>
                                        <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenuStyle}">
                                            <Setter Property="MaxHeight" Value="150"/>
                                        </Style>
                                    </MenuItem.Resources>
                                </MenuItem>

                                <Separator Margin="0,4">
                                    <Separator.Template>
                                        <ControlTemplate TargetType="Separator">
                                            <!-- Cria um retângulo fino que ignora as margens de ícones e encosta nas duas bordas -->
                                            <Rectangle Height="1" Fill="#2D323F" HorizontalAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Separator.Template>
                                </Separator>
                                
                                <MenuItem Header="ℹ Informações do Torrent" Style="{StaticResource DarkMenuItemStyle}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="⛶" Click="FullscreenButton_Click" Style="{StaticResource PlayerButtonStyle}" FontSize="18" ToolTip="Tela Cheia"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>